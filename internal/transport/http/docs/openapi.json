{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "2.0.0",
    "description": "CRUD API for tasks with optional recurrence schedules, built with clean architecture."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Operations with tasks"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks",
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskMutationRequest" },
              "examples": {
                "one-time": {
                  "summary": "One-time task (no schedule)",
                  "value": {
                    "title": "Patient follow-up call",
                    "description": "Call patient to confirm appointment",
                    "status": "new"
                  }
                },
                "daily": {
                  "summary": "Daily every 2 days",
                  "value": {
                    "title": "Daily report",
                    "status": "new",
                    "schedule": { "type": "daily", "interval": 2 }
                  }
                },
                "monthly": {
                  "summary": "Monthly on the 15th",
                  "value": {
                    "title": "Inventory check",
                    "status": "new",
                    "schedule": { "type": "monthly", "day_of_month": 15 }
                  }
                },
                "specific": {
                  "summary": "On specific dates",
                  "value": {
                    "title": "Conference prep",
                    "status": "new",
                    "schedule": { "type": "specific", "dates": ["2026-04-10", "2026-04-20"] }
                  }
                },
                "parity": {
                  "summary": "Even days of the month",
                  "value": {
                    "title": "Reporting",
                    "status": "new",
                    "schedule": { "type": "parity", "parity": "even" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update task (full replacement)",
        "description": "Replaces all task fields. To remove a schedule, omit the `schedule` field or set it to `null`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskMutationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "ScheduleInput": {
        "type": "object",
        "required": ["type"],
        "description": "Recurrence rule for a task. Only the fields relevant to the chosen type are required.",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["daily", "monthly", "specific", "parity"],
            "description": "Kind of recurrence."
          },
          "interval": {
            "type": "integer",
            "minimum": 1,
            "description": "Required for type=daily. Repeat every N days."
          },
          "day_of_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Required for type=monthly. Day of month (1–30). If the month is shorter, the last available day is used."
          },
          "dates": {
            "type": "array",
            "items": { "type": "string", "format": "date" },
            "description": "Required for type=specific. List of exact dates in YYYY-MM-DD format."
          },
          "parity": {
            "type": "string",
            "enum": ["even", "odd"],
            "description": "Required for type=parity. Tasks run on even or odd days of the month."
          }
        }
      },
      "Schedule": {
        "type": "object",
        "description": "Recurrence rule stored with the task.",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "type": {
            "type": "string",
            "enum": ["daily", "monthly", "specific", "parity"]
          },
          "interval": { "type": "integer", "minimum": 1 },
          "day_of_month": { "type": "integer", "minimum": 1, "maximum": 30 },
          "dates": {
            "type": "array",
            "items": { "type": "string", "format": "date" }
          },
          "parity": { "type": "string", "enum": ["even", "odd"] }
        }
      },
      "TaskMutationRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Daily patient calls"
          },
          "description": {
            "type": "string",
            "example": "Call all scheduled patients"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "schedule": {
            "nullable": true,
            "$ref": "#/components/schemas/ScheduleInput"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Daily patient calls" },
          "description": {
            "type": "string",
            "example": "Call all scheduled patients"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "schedule": {
            "nullable": true,
            "$ref": "#/components/schemas/Schedule"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-10T09:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-10T09:00:00Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "task not found" }
        }
      }
    }
  }
}
